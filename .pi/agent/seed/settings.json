{
  "theme": "catppuccin-mocha",
  "defaultProvider": "cubbit",
  "defaultModel": "cubbit/mimir-pro",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "extensions": ["-builtin:mcp"],
  "packages": [
    "npm:pi-web-access@0.47.0",
    "npm:pi-vision-handoff@0.10.13",
    "npm:pi-simplify@0.2.3",
    "npm:@dietrichgebert/ponytail@5.3.3",
    "npm:bigpowers@2.93.3",
    "npm:pi-lens@4.4.9",
    "npm:pi-subagents@0.86.0",
    "npm:pi-background-tasks@2.6.10",
    "npm:pi-zentui@0.34.0",
    "npm:pi-observational-memory@3.1.4",
    "npm:pi-mcp-adapter@7.0.1"
  ],
  "compaction": {
    "reserveTokens": 16384,
    "modelOverrides": {
      "cubbit/cubbit/mimir": { "reserveTokens": 131072 },
      "cubbit-headroom/cubbit/mimir": { "reserveTokens": 131072 },
      "cubbit/cubbit/mimir-pro": { "reserveTokens": 131072 },
      "cubbit-headroom/cubbit/mimir-pro": { "reserveTokens": 131072 },
      "cubbit/cubbit/mimir-slim": { "reserveTokens": 32768 },
      "cubbit-headroom/cubbit/mimir-slim": { "reserveTokens": 32768 }
    }
  },
  "observational-memory": {
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.9
  }
}
