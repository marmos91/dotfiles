{
  "lastChangelogVersion": "0.87.1",
  "theme": "catppuccin-mocha",
  "tuiMode": "fullscreen",
  "defaultProvider": "cubbit",
  "defaultModel": "vllm/mimir",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-vision-handoff",
    "npm:pi-simplify",
    "npm:@dietrichgebert/ponytail",
    "npm:bigpowers",
    "npm:pi-lens",
    "npm:pi-subagents",
    "npm:pi-background-tasks",
    "npm:pi-zentui",
    "npm:pi-observational-memory",
    "npm:pi-mcp-adapter"
  ],
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "cubbit/vllm/mimir": { "reserveTokens": 131072 },
      "cubbit-headroom/vllm/mimir": { "reserveTokens": 131072 },
      "cubbit/cubbit/mimir-small": { "reserveTokens": 32768 },
      "cubbit-headroom/cubbit/mimir-small": { "reserveTokens": 32768 }
    }
  },
  "observational-memory": {
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.9
  }
}
