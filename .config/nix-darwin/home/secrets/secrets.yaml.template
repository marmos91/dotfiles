# Template for secrets.yaml. This file is the bootstrap template: `secrets.yaml`
# is created only by `sops --encrypt` (see README) and is always committed
# encrypted. `default.nix` is the source of truth for which keys are required.
#
# Each key here corresponds to a secret defined in default.nix
# The value should be the full file contents (use | for multiline)

kubeconfig: |
  apiVersion: v1
  kind: Config
  clusters:
    - cluster:
        server: https://your-cluster.example.com
        certificate-authority-data: BASE64_CA_CERT
      name: my-cluster
  contexts:
    - context:
        cluster: my-cluster
        user: my-user
      name: my-context
  current-context: my-context
  users:
    - name: my-user
      user:
        token: YOUR_TOKEN_HERE

aws_credentials: |
  [default]
  aws_access_key_id = YOUR_ACCESS_KEY
  aws_secret_access_key = YOUR_SECRET_KEY

  [profile-name]
  aws_access_key_id = OTHER_ACCESS_KEY
  aws_secret_access_key = OTHER_SECRET_KEY

aws_config: |
  [default]
  region = us-east-1
  output = json

  [profile profile-name]
  region = eu-west-1
  output = json

rclone_config: |
  [remote]
  type = s3
  provider = Other
  access_key_id = YOUR_ACCESS_KEY
  secret_access_key = YOUR_SECRET_KEY
  endpoint = https://your-endpoint.example.com

ssh_hosts_config: |
  # SSH hosts with mnemonic names
  # Add your hosts here, e.g.:
  # Host my-server
  #   HostName 10.0.0.1
  #   User myuser
  #   IdentityFile ~/.ssh/my-key

mimir_api_key: |
  YOUR_MIMIR_API_KEY

mimir_base_url: |
  https://your-mimir-endpoint.example.com/v1

google_docs_mcp_client_id: |
  YOUR_CLIENT_ID.apps.googleusercontent.com

google_docs_mcp_client_secret: |
  YOUR_CLIENT_SECRET

ds3ctl_config: |
  # ds3ctl config — see the ds3ctl docs for the full schema
  endpoint: https://your-endpoint.example.com
  access_key: YOUR_ACCESS_KEY
  secret_key: YOUR_SECRET_KEY

git_identity: |
  [user]
    email = your-personal@example.com

git_identity_work: |
  [user]
    email = your-work@example.com

git_allowed_signers: |
  your-personal@example.com ssh-ed25519 AAAA_YOUR_PUBLIC_KEY
  your-work@example.com ssh-ed25519 AAAA_YOUR_PUBLIC_KEY

# gcal-personal-block (hourly launchd agent: mirror Family calendar onto
# the work calendar as opaque "Personal Commitment" blocks)
# client id/secret come from the Google Cloud Console OAuth client (type
# "Desktop"); family-cal and work-email name the calendars to sync.
gcal_client_id: YOUR_GCP_OAUTH_CLIENT_ID
gcal_client_secret: YOUR_GCP_OAUTH_CLIENT_SECRET
gcal_family_cal: YOUR_FAMILY_CALENDAR_ID@group.calendar.google.com
gcal_work_email: your.work@account.example
