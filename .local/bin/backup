#!/usr/bin/env bash
# Level-1 backup: this Mac -> MarcoBackups (NAS) over the tailnet, via restic's
# SFTP backend. Three lifecycle tiers, each its own restic tag with its own
# retention (see `prune`). Declarative install + schedule live in
# home/programs/utilities/backup.nix; this script is the runtime.
#
#   backup run     back up all tiers (the daily launchd job)
#   backup prune   apply per-tier retention + prune (the weekly launchd job)
#   backup init    initialise the repo if absent (idempotent; run at setup)
#   backup <restic-args...>   passthrough, e.g. `backup snapshots`, `backup check`
set -uo pipefail

ERRLOG_DIR="$HOME/.local/state/restic/logs"
# Per-tier / per-prune ceiling. A first full backup or a catch-up run after a
# long trip can take hours over a tailnet, so these are generous; the point is
# only to bound a hang. Kept in-script (not launchd TimeoutSeconds) so a timeout
# is still a normal failure that alerts and leaves no stale repo lock.
BACKUP_TIMEOUT="${BACKUP_TIMEOUT:-6h}"
PRUNE_TIMEOUT="${PRUNE_TIMEOUT:-4h}"

# Surface a failure to the logged-in user (launchd stays silent on non-zero exit):
# toast (osascript needs Script Editor's notification permission — keep it on),
# sound, and a marker file the shell precmd hook (zsh.nix) prints as a red warning.
# Defined before the repository check below, which also needs to alert.
notify() {
  local marker="$HOME/.local/state/restic/FAILED"
  local detail="${2:-}"
  # Strip any URL (the repo URL names the private NAS host) and quote chars, so
  # the detail is safe in the AppleScript literal and in a public shell prompt.
  detail=$(printf '%s' "$detail" | sed -E 's#(sftp|https?)://[^[:space:]]+#<repo>#g')
  detail=${detail//\"//}; detail=${detail//\\//}; detail=${detail//\'/}
  /usr/bin/osascript -e "display notification \"$detail\" with title \"$1\"" >/dev/null 2>&1 || true
  /usr/bin/afplay /System/Library/Sounds/Submarine.aiff >/dev/null 2>&1 || true
  ( umask 077; { echo "$(date '+%Y-%m-%d %H:%M') $1"; printf '%s\n' "$detail"; } > "$marker" ) 2>/dev/null || true
}

# Repository URL names the NAS host, so it comes from sops (see home/secrets/),
# not this public script. Override with RESTIC_REPOSITORY for ad-hoc targets.
export RESTIC_REPOSITORY="${RESTIC_REPOSITORY:-$(cat "$HOME/.config/restic/repository" 2>/dev/null)}"
export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-$HOME/.config/restic/password}"
[ -n "$RESTIC_REPOSITORY" ] || {
  echo "no repository: ~/.config/restic/repository missing (sops not rendered?)" >&2
  notify "Backup failed — no repository" "~/.config/restic/repository is missing (sops not rendered?)"
  exit 1
}
EXCLUDES="$HOME/.config/restic/excludes"
H="$HOME"

# Only pass paths that exist, so a missing dir never aborts the run.
_present() { local out=(); local p; for p in "$@"; do [ -e "$p" ] && out+=("$p"); done; printf '%s\n' "${out[@]}"; }

tier_paths() {
  case "$1" in
    ephemeral) _present "$H/Downloads" "$H/Desktop" ;;
    standard)
      _present "$H/Pictures/Lightroom" "$H/Documents" "$H/Presentations" \
        "$H/.pulumi/stacks" "$H/.pulumi/history" "$H/.pulumi/backups" \
        "$H/.pi/agent/missions" \
        "$H/.headroom/memory.db" "$H/.headroom/memory_graph.db" "$H/.headroom/memory_vectors.db" \
        $H/.claude/projects/*/memory
      # Extra paths that name private infra (clusters, customers) live in a
      # sops-rendered file, never this public script. One $HOME-relative path
      # per line; '#' comments and blanks ignored. Missing file => skipped.
      if [ -r "$H/.config/restic/extra-paths" ]; then
        while IFS= read -r line; do
          case "$line" in ''|\#*) continue ;; esac
          _present "$H/$line"
        done < "$H/.config/restic/extra-paths"
      fi
      ;;
    archive) _present "$H/Archive" ;;
  esac
}

do_backup() {
  local rc=0 tag
  local failed=""
  for tag in ephemeral standard archive; do
    mapfile -t paths < <(tier_paths "$tag")
    [ "${#paths[@]}" -eq 0 ] && continue
    echo ">> backing up tier '$tag' (${#paths[@]} paths)"
    # A hung restic (stalled tailnet/SFTP) must not suppress every later run, so
    # each tier is bounded in-script rather than by launchd's TimeoutSeconds —
    # launchd SIGKILLs the job, which would skip the notify below and leave a
    # stale repo lock behind. A timeout here is just a normal failure.
    if ! timeout "$BACKUP_TIMEOUT" restic backup --tag "$tag" --exclude-file "$EXCLUDES" "${paths[@]}"; then
      rc=1
      failed="$failed $tag"
    fi
  done
  [ "$rc" -eq 0 ] || notify "Backup failed —${failed}" "see $ERRLOG_DIR/backup.err.log"
  return $rc
}

do_prune() {
  local rc=0
  timeout "$PRUNE_TIMEOUT" restic forget --tag ephemeral --keep-daily 7 --keep-weekly 4 || rc=1
  timeout "$PRUNE_TIMEOUT" restic forget --tag standard  --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --keep-yearly 2 || rc=1
  timeout "$PRUNE_TIMEOUT" restic forget --tag archive   --keep-monthly 12 --keep-yearly 10 || rc=1
  timeout "$PRUNE_TIMEOUT" restic prune || rc=1
  [ "$rc" -eq 0 ] || notify "Backup prune failed" "see $ERRLOG_DIR/prune.err.log"
  return $rc
}

case "${1:-run}" in
  run)   do_backup; rc=$?; [ "$rc" -eq 0 ] && rm -f "$HOME/.local/state/restic/FAILED"; exit $rc ;;
  # A successful prune must not clear a backup-failure marker: backups can keep
  # failing Mon-Sat while Sunday's prune succeeds, and the shell warning would
  # then vanish before the next failing run.
  prune) do_prune; rc=$?; exit $rc ;;
  init)  restic cat config >/dev/null 2>&1 && echo "repo already initialised" || restic init ;;
  *)     exec restic "$@" ;;
esac
