# Created by https://www.toptal.com/developers/gitignore/api/visualstudiocode,macos,fish
# Edit at https://www.toptal.com/developers/gitignore?templates=visualstudiocode,macos,fish

### Fish ###
fishd.*
fish_history
fish_variables
config.local.fish

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# End of https://www.toptal.com/developers/gitignore/api/visualstudiocode,macos,fish

.config/*
!.config/aerospace
!.config/gh
# gh writes a live oauth_token into hosts.yml when no OS keyring is available;
# the re-include above only keeps config.yml tracked.
.config/gh/hosts.yml
!.config/nix-darwin
!.config/nvim

# GnuPG homedir: no longer tracked, but a machine whose ~/.gnupg is still a
# stow-folded symlink writes live key material here until activation migrates it.
.gnupg/

# Generated artifacts (regenerable, not source)
graphify-out/
.tokensave/
# nix-darwin build symlink
result

# pi runtime task output (cwd-relative, no config knob)
.pi/tasks/

### Claude Code runtime state (managed by home-manager, not stow)
# Transcripts, history, todos and shell snapshots land in ~/.claude; only the
# hook script and the settings seed belong in the repo.
.claude/*
!.claude/settings.json
!.claude/hooks/
