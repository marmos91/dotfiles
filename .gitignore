# The repo manages no global git ignore file, so OS noise is ignored here.
.DS_Store

.config/*
!.config/aerospace
!.config/gh
# gh writes a live oauth_token into hosts.yml when no OS keyring is available;
# the re-include above only keeps config.yml tracked.
.config/gh/hosts.yml
!.config/nix-darwin
!.config/nvim

# GnuPG homedir: no longer tracked, but a machine whose ~/.gnupg is still a
# stow-folded symlink writes live key material here until activation migrates it.
.gnupg/

# Generated artifacts (regenerable, not source)
graphify-out/
.tokensave/
# nix-darwin build symlink
result

# pi runtime task output (cwd-relative, no config knob)
.pi/tasks/

### Claude Code runtime state (managed by home-manager, not stow)
# Transcripts, history, todos and shell snapshots land in ~/.claude; only the
# hook script and the settings seed belong in the repo.
.claude/*
!.claude/settings.json
!.claude/hooks/
